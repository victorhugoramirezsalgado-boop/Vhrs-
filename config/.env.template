# BBVA API Configuration Template
# Renombra este archivo a .env y completa con tus credenciales

# BBVA Banking API
BBVA_CLIENT_ID=your_bbva_client_id_here
BBVA_CLIENT_SECRET=your_bbva_client_secret_here
BBVA_API_URL=https://apis.bbva.com/

# BBVA Account Information
BBVA_ACCOUNT_NUMBER=your_account_number_here
BBVA_ROUTING_NUMBER=your_routing_number_here

# Alpaca Trading API (Optional)
ALPACA_API_KEY_ID=your_alpaca_key_here
ALPACA_API_SECRET_KEY=your_alpaca_secret_here

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# GitHub Token
GITHUB_TOKEN=your_github_token_here

# System Settings
ENVIRONMENT=development
DEBUG_MODE=false